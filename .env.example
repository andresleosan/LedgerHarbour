# Production activation requires the five production modes below. The Playwright
# harness overrides them with explicit test-safe providers.
PERSISTENCE_MODE=postgres
DATABASE_URL=postgresql://localhost:5432/ledgerharbour
# DATABASE_URL is required by the production gate.
TEST_DATABASE_URL=postgresql://localhost:5432/ledgerharbour_test
ALLOW_STAGING_MIGRATION=false
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=ledgerharbour
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace-with-firebase-private-key
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ledgerharbour.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ledgerharbour
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id
STORAGE_MODE=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=ledgerharbour
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
OCR_PROVIDER=google-document-ai
GOOGLE_CLOUD_PROJECT_ID=replace-with-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=replace-with-invoice-parser-id
# Non-secret placeholder only. Production must use the runtime secret manager.
GOOGLE_SERVICE_ACCOUNT_JSON=replace-with-json-secret
RATE_LIMIT_MODE=upstash
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
