PERSISTENCE_MODE=memory
DATABASE_URL=postgresql://localhost:5432/ledgerharbour
# DATABASE_URL is required only when PERSISTENCE_MODE=postgres.
TEST_DATABASE_URL=postgresql://localhost:5432/ledgerharbour_test
ALLOW_STAGING_MIGRATION=false
# AUTH_MODE=development|firebase
AUTH_MODE=development
DEV_SESSION_SECRET=replace-with-a-development-only-secret
FIREBASE_PROJECT_ID=ledgerharbour
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace-with-firebase-private-key
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ledgerharbour.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ledgerharbour
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id
STORAGE_MODE=local
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=ledgerharbour
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
OCR_PROVIDER=none
