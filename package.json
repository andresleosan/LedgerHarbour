{
  "name": "ledgerharbour",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:check": "tsx scripts/db/check.ts",
    "db:native-check": "vitest run tests/integration/postgres/native-schema.test.ts",
    "lint": "eslint src tests --no-config-lookup --parser @typescript-eslint/parser --plugin @typescript-eslint --ext .ts,.tsx --rule @typescript-eslint/no-unused-vars:error",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "drizzle-orm": "0.45.2",
    "next": "15.5.23",
    "next-intl": "4.13.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "9.39.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
